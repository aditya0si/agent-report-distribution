# Deployment environment (everything below has a safe default in code).
AGENT_REPORTS_REGION=us-east-1
AGENT_REPORTS_RAW_BUCKET=agent-reports-raw
AGENT_REPORTS_PROCESSED_BUCKET=agent-reports-processed
AGENT_REPORTS_REPORTS_BUCKET=agent-reports-out

# SQS: fan-out queue + dead-letter queue created by infra/terraform.
AGENT_REPORTS_AGENT_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/agent-reports-fanout
AGENT_REPORTS_DLQ_URL=https://sqs.us-east-1.amazonaws.com/000000000000/agent-reports-fanout-dlq

# SES: verified sender identity + configuration set.
AGENT_REPORTS_SES_SENDER=reports@example.com
AGENT_REPORTS_SES_CONFIGURATION_SET=agent-reports

# Pre-signed report link TTL in seconds (S3 SigV4 hard limit is 604800 = 7 days).
AGENT_REPORTS_PRESIGN_TTL_SECONDS=3600

# Guardrails
AGENT_REPORTS_MAX_REPORT_BYTES=2000000
AGENT_REPORTS_SQS_BATCH_SIZE=10
AGENT_REPORTS_LOG_LEVEL=INFO

# Only set this to point boto3 at LocalStack or another S3-compatible endpoint.
# Leave empty for real AWS and for the moto-based offline test path.
AGENT_REPORTS_ENDPOINT_URL=

# Free-tier (Lambda chunker) vs scale (EMR Serverless Spark) routing threshold. The chunker reads
# this on every run: above it, the run logs an `emr_routing_advised` event naming the numbers, so the
# decision to enable the EMR module is visible instead of implicit. It does not switch paths by
# itself - AGENT_REPORTS_CHUNKER_MAX_POLICIES is the hard guardrail that fails a run.
AGENT_REPORTS_EMR_ROW_THRESHOLD=5000000
AGENT_REPORTS_REPORT_DATE=

# DEV ONLY - leave unset in every deployed environment. When set to 1 the presign handler trusts the
# caller-supplied X-Caller-Agent-Id / X-Caller-Role request headers as the caller identity. Headers
# are spoofable, so enabling this lets any caller read any agent's report; it exists for offline
# runs against a stack with no API Gateway authorizer. The Terraform stack never sets it.
# AGENT_REPORTS_ALLOW_CALLER_HEADER_FALLBACK=1
